{
  "name": "micropolisJS",
  "version": "0.0.1",
  "description": "A modified continuation of Graeme McCutcheon's micropolisJS, his Javascript/HTML5 port of the open-source simulator \"Micropolis\", growing into a multiplayer city builder on a C# server",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdamTovatt/micropolisJS.git"
  },
  "bugs": {
    "url": "https://github.com/AdamTovatt/micropolisJS/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --watch --mode development",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:golden": "E2E_WRITE_GOLDEN=1 playwright test --config e2e/playwright.config.ts e2e/playthrough.spec.ts",
    "lint": "eslint",
    "record": "tsx test/recordings/record.ts",
    "benchmark": "dotnet run --project server/Micropolis.Benchmarks -c Release -- --output docs/benchmarks.md",
    "dev": "webpack serve --mode development",
    "production": "webpack serve --mode production"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/jest": "30.0.0",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "13.0.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-webpack-plugin": "5.6.3",
    "jest": "30.0.4",
    "ts-jest": "29.4.0",
    "ts-loader": "9.5.2",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.0",
    "webpack": "5.100.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  },
  "author": "Graeme McCutcheon (http://www.graememcc.co.uk)",
  "license": "GPL-3.0",
  "readmeFilename": "README.md"
}
