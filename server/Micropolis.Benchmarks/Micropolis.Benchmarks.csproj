<Project Sdk="Microsoft.NET.Sdk">

  <!-- Times the C# simulation on the committed fixtures and writes the report docs/benchmarks.md holds, from the game
       rules alone: no host, no rule file touched -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Micropolis.Benchmarks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Micropolis.Rules\Micropolis.Rules.csproj" />
  </ItemGroup>

  <!-- The fixtures' saves are read in place, from the repository root, as the tests read them -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
