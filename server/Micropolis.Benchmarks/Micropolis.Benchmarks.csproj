<Project Sdk="Microsoft.NET.Sdk">

  <!-- Times the C# simulation on the committed fixtures, measures the state messages its players are sent, and writes
       the report docs/benchmarks.md holds, from the game rules alone: no host, no rule file touched -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Micropolis.Benchmarks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the fixtures, Fixtures.cs, whose saves it runs -->
    <ProjectReference Include="..\Micropolis.Conformance\Micropolis.Conformance.csproj" />
    <ProjectReference Include="..\Micropolis.Rules\Micropolis.Rules.csproj" />
    <ProjectReference Include="..\Micropolis.SourceTree\Micropolis.SourceTree.csproj" />
  </ItemGroup>

</Project>
