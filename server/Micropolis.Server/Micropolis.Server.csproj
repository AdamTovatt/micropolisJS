<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- In development, dotnet run starts the client's dev server too and sends the browser to it: SpaProxy, enabled by
       ASPNETCORE_HOSTINGSTARTUPASSEMBLIES in Properties/launchSettings.json, runs SpaProxyLaunchCommand in SpaRoot
       unless SpaProxyServerUrl already answers. Outside development the server serves the client from wwwroot, which
       publishing fills with the built dist/. -->
  <PropertyGroup>
    <SpaRoot>..\..\</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://localhost:8080</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Micropolis.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EasyReasy.Auth" Version="5.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.11" />
    <!-- The IdentityModel packages only work at one version, and mixed ones reject every token (IDX14102).
         EasyReasy.Auth references a newer Microsoft.IdentityModel.Tokens than the JwtBearer it depends on brings these
         two at, so these follow the version of Microsoft.IdentityModel.Tokens in the restored graph. They come out once
         EasyReasy.Auth pins every IdentityModel package itself. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Micropolis.Rules\Micropolis.Rules.csproj" />
  </ItemGroup>

  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />

    <ItemGroup>
      <ClientDistFiles Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
