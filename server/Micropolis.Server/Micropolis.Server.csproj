<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- In development, dotnet run starts the client's dev server too and sends the browser to it: SpaProxy, enabled by
       ASPNETCORE_HOSTINGSTARTUPASSEMBLIES in Properties/launchSettings.json, runs SpaProxyLaunchCommand in SpaRoot
       unless SpaProxyServerUrl already answers. Outside development the server serves the client from wwwroot, which
       publishing fills with the built dist/. -->
  <PropertyGroup>
    <SpaRoot>..\..\</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://localhost:44903</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Micropolis.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-core" />
    <PackageReference Include="dbup-sqlite" />
    <PackageReference Include="EasyReasy.Auth" />
    <PackageReference Include="EasyReasy.Database" />
    <PackageReference Include="EasyReasy.Database.Mapping" />
    <PackageReference Include="EasyReasy.Database.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Micropolis.Rules\Micropolis.Rules.csproj" />
  </ItemGroup>

  <!-- The city database's schema, which CityDatabase runs in order of the scripts' numbers -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>

  <Target Name="PublishClient" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />

    <ItemGroup>
      <ClientDistFiles Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
